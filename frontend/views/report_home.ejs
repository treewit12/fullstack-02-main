<%- include('navbar') %>

<h2>📊 Reports</h2>

<a href="/reports/export" class="btn-export">⬇ Export Excel</a>

<h3>👨‍💻 Employee Sales Report</h3>

<table border="1">
    <tr>
        <th>Employee</th>
        <th>Total Transactions</th>
        <th>Total Sales</th>
    </tr>
    <% test && console.log("Testa from API:", test) %>
    <% employees.forEach(e => { %>
    <tr>
        <td><%= e.employee_name %></td>
        <td><%= e.total_transactions %></td>
        <td>฿<%= e.total_sales ? e.total_sales.toLocaleString() : 0 %></td>
    </tr>
    <% }) %>

</table>