<%- include('navbar') %>
<link rel="stylesheet" href="/css/style.css">

<h1>Transactions</h1>

<a href="/transactions/add" class="btn-success">
    + เพิ่มรายการ
</a>

<br><br>

<table border="1" cellpadding="8">
<tr>
    <th>สินค้า</th>
    <th>หมวดหมู่</th>
    <th>ผู้ทำรายการ</th>
    <th>ประเภทรายการ</th>
    <th>จำนวน</th>
    <th>ราคารวม</th>
    <th>วันที่</th>
</tr>

<% transactions.forEach(t => { %>

<tr class="<%= t.transaction_type === 'IN' ? 'row-in' : 'row-out' %>">

    <td><%= t.product_name %></td>
    <td><%= t.category_name %></td>

    <!-- แสดงชื่อให้ถูกประเภท -->
    <td>
        <% if (t.transaction_type === 'IN') { %>
            <%= t.supplier_name || '-' %>
        <% } else { %>
            <%= t.employee_name || '-' %>
        <% } %>
    </td>

    <td>
        <% if (t.transaction_type === 'IN') { %>
            <span class="badge-in">รับเข้า</span>
        <% } else { %>
            <span class="badge-out">จ่ายออก</span>
        <% } %>
    </td>

    <td><%= t.quantity %></td>
    <td><%= t.total_price %></td>
    <td><%= t.created_at %></td>

</tr>

<% }) %>

</table>