<%- include('../navbar') %>
<link rel="stylesheet" href="/style.css">

<h1>Suppliers</h1>

<a href="/suppliers/add">➕ เพิ่ม Supplier</a>

<table border="1" cellpadding="8">
<tr>
    <th>ชื่อ</th>
    <th>เบอร์</th>
    <th>Email</th>
    <th>ที่อยู่</th>
    <th>จัดการ</th>
</tr>

<% suppliers.forEach(s => { %>
<tr>
    <td><%= s.supplier_name %></td>
    <td><%= s.phone %></td>
    <td><%= s.email %></td>
    <td><%= s.address %></td>
    <td>
        <a href="/suppliers/edit/<%= s.supplier_id %>">แก้ไข</a>
        |
        <a href="/suppliers/delete/<%= s.supplier_id %>" 
           onclick="return confirm('ยืนยันการลบ?')">ลบ</a>
    </td>
</tr>
<% }) %>
</table>