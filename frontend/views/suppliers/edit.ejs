<%- include('../navbar') %>
<link rel="stylesheet" href="/css/style.css">

<div class="container">
    <div class="form-card">

        <a href="/suppliers" class="back-link">← กลับไปหน้า Supplier</a>

        <h1>แก้ไข Supplier</h1>

        <form method="POST" action="/suppliers/update/<%= supplier.id %>">

            <div class="form-group">
                <label>ชื่อ Supplier</label>
                <input type="text"
                       name="name"
                       value="<%= supplier.name %>"
                       required>
            </div>

            <div class="form-group">
                <label>เบอร์โทร</label>
                <input type="text"
                       name="phone"
                       value="<%= supplier.phone %>">
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email"
                       name="email"
                       value="<%= supplier.email %>">
            </div>

            <div class="form-group">
                <label>ที่อยู่</label>
                <input type="text"
                       name="address"
                       value="<%= supplier.address %>">
            </div>

            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-success">
                    บันทึกการแก้ไข
                </button>

                
                </a>
            </div>

        </form>

    </div>
</div>