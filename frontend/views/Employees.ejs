<%- include('navbar') %>
<link rel="stylesheet" href="/css/style.css">

<h1>Employees</h1>

<a href="/employees/add" class="btn-success">
    + เพิ่ม Employees
</a>

<br><br>

<table border="1" cellpadding="8" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>ชื่อพนักงาน</th>
            <th>ตำแหน่ง</th>
            <th>เบอร์โทร</th>
            <th>จัดการ</th>
        </tr>
    </thead>

    <tbody>
        <% employees.forEach(e => { %>
            <tr>
                <td><%= e.employee_id %></td>
                <td><%= e.employee_name %></td>
                <td><%= e.position %></td>
                <td><%= e.phone %></td>
                <td>
                    <a href="/employees/edit/<%= e.employee_id %>" 
                       class="btn-edit">
                       แก้ไข
                    </a>

                    <a href="/employees/delete/<%= e.employee_id %>" 
                       class="btn-delete"
                       onclick="return confirm('ยืนยันการลบ?')">
                       ลบ
                    </a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>