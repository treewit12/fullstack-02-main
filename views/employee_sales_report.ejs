<%- include('navbar') %>

<h2>👨‍💻 Employee Sales Report</h2>

<table border="1">
    <tr>
        <th>Employee</th>
        <th>Total Transactions</th>
        <th>Total Quantity</th>
    </tr>

    <% employees.forEach(e => { %>
    <tr>
        <td><%= e.employee_name %></td>
        <td><%= e.total_transactions %></td>
        <td><%= e.total_quantity %></td>
    </tr>
    <% }) %>

</table>