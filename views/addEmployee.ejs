<%- include('navbar') %>
<link rel="stylesheet" href="/css/style.css">

<div class="container">
    <div class="form-card">

        <a href="/employees" class="back-link">
            ← กลับไปหน้าพนักงาน
        </a>

        <h1>เพิ่มพนักงาน</h1>

        <form action="/employees/create" method="POST">

            <div class="form-group">
                <label>ชื่อพนักงาน</label>
                <input type="text"
                       name="employee_name"
                       required>
            </div>

            <div class="form-group">
                <label>ตำแหน่ง</label>
                <input type="text"
                       name="position"
                       required>
            </div>

            <div class="form-group">
                <label>เบอร์โทร</label>
                <input type="text"
                       name="phone"
                       required>
            </div>

            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-success">
                    บันทึก
                </button>

                </a>
            </div>

        </form>

    </div>
</div>