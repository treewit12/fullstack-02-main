<%- include('navbar') %>
<link rel="stylesheet" href="/css/style.css">

<div class="container">
    <div class="form-card">

        <a href="/transactions" class="back-link">
            ← กลับไปหน้ารายการ Transaction
        </a>

        <h1>เพิ่มรายการ Transaction</h1>

        <form action="/transactions/create" method="POST">

            <div class="form-group">
                <label>สินค้า</label>
                <select name="product_id" required>
                    <% products.forEach(p => { %>
                        <option value="<%= p.id %>">
                            <%= p.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label>พนักงาน</label>
                <select name="employee_id" required>
                    <% employees.forEach(e => { %>
                        <option value="<%= e.employee_id %>">
                            <%= e.employee_name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label>ประเภท</label>
                <select name="transaction_type" required>
                    <option value="IN">รับเข้า (IN)</option>
                    <option value="OUT">ขายออก (OUT)</option>
                </select>
            </div>

            <div class="form-group">
                <label>จำนวน</label>
                <input type="number"
                       name="quantity"
                       min="1"
                       required>
            </div>

            <div class="form-group">
                <label>ราคารวม (บาท)</label>
                <input type="number"
                       name="total_price"
                       step="0.01"
                       min="0"
                       required>
            </div>

            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-success">
                    บันทึก
                </button>

              
                </a>
            </div>

        </form>

    </div>
</div>