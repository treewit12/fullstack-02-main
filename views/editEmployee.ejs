<%- include('navbar') %>
<link rel="stylesheet" href="/css/style.css">

<div class="container">
    <div class="form-card">

        <a href="/employees" class="back-link">
            ← กลับไปหน้าพนักงาน
        </a>

        <h1>แก้ไข Employees</h1>

        <form action="/employees/update/<%= employee.employee_id %>" method="POST">

            <div class="form-group">
                <label>ชื่อ Employees</label>
                <input type="text"
                       name="employee_name"
                       value="<%= employee.employee_name %>"
                       required>
            </div>

            <div class="form-group">
                <label>ตำแหน่ง</label>
                <input type="text"
                       name="position"
                       value="<%= employee.position %>"
                       required>
            </div>

            <div class="form-group">
                <label>เบอร์โทร</label>
                <input type="text"
                       name="phone"
                       value="<%= employee.phone %>"
                       required>
            </div>

            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-success">
                    บันทึกการแก้ไข
                </button>

              
                </a>
            </div>

        </form>

    </div>
</div>