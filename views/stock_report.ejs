<%- include('navbar') %>

<h1>📦 Stock Report</h1>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Product Name</th>
        <th>Price</th>
        <th>Stock</th>
    </tr>

    <% products.forEach(p => { %>
        <tr>
            <td><%= p.id %></td>
            <td><%= p.name %></td>
            <td><%= p.price %></td>
            <td><%= p.stock %></td>
        </tr>
    <% }) %>

</table>