<%- include('../navbar') %>

<h1>แก้ไข Supplier</h1>

<form method="POST" action="/suppliers/update/<%= supplier.id %>">

    <label>ชื่อ:</label>
    <input type="text"
           name="name"
           value="<%= supplier.name %>"
           required>
    <br><br>

    <label>เบอร์:</label>
    <input type="text"
           name="phone"
           value="<%= supplier.phone %>">
    <br><br>

    <label>Email:</label>
    <input type="email"
           name="email"
           value="<%= supplier.email %>">
    <br><br>

    <label>ที่อยู่:</label>
    <input type="text"
           name="address"
           value="<%= supplier.address %>">
    <br><br>

    <button type="submit">อัปเดต</button>
    <a href="/suppliers">ยกเลิก</a>

</form>