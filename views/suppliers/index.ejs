<%- include('../navbar') %>
<link rel="stylesheet" href="/style.css">

<h1>Supplier</h1>

<a href="/suppliers/add" class="btn-success">
    + เพิ่ม Supplier
</a>

<br><br>

<table border="1" cellpadding="8">
    <tr>
        <th>ID</th>
        <th>ชื่อ</th>
        <th>เบอร์</th>
        <th>Email</th>
        <th>ที่อยู่</th>
        <th>จัดการ</th>
    </tr>

    <% suppliers.forEach(supplier => { %>
        <tr>
            <td><%= supplier.id %></td>
            <td><%= supplier.name %></td>
            <td><%= supplier.phone %></td>
            <td><%= supplier.email %></td>
            <td><%= supplier.address %></td>
            <td>
                <a href="/suppliers/edit/<%= supplier.id %>" 
                   class="btn-edit">
                   แก้ไข
                </a>

                <a href="/suppliers/delete/<%= supplier.id %>" 
                   class="btn-delete"
                   onclick="return confirm('ยืนยันการลบ?')">
                   ลบ
                </a>
            </td>
        </tr>
    <% }) %>
</table>