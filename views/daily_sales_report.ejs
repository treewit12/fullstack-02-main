<%- include('navbar') %>

<h2>📅 Daily Sales Report</h2>

<table border="1">
    <tr>
        <th>Date</th>
        <th>Total Transactions</th>
        <th>Total Quantity</th>
    </tr>

    <% sales.forEach(s => { %>
    <tr>
        <td><%= s.sale_date %></td>
        <td><%= s.total_transactions %></td>
        <td><%= s.total_quantity %></td>
    </tr>
    <% }) %>

</table>